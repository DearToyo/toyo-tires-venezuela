<svg width="800" height="800" viewBox="0 0 800 800" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#f5f5f5;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#e0e0e0;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="800" height="800" fill="url(#bg)"/>
  
  <!-- Tire outline -->
  <circle cx="400" cy="400" r="280" fill="none" stroke="#0062B0" stroke-width="3" opacity="0.3"/>
  <circle cx="400" cy="400" r="240" fill="none" stroke="#0062B0" stroke-width="2" opacity="0.2"/>
  <circle cx="400" cy="400" r="120" fill="none" stroke="#0062B0" stroke-width="2" opacity="0.2"/>
  
  <!-- Toyo Blue accent -->
  <text x="400" y="380" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#0062B0" text-anchor="middle">
    TOYO TIRES
  </text>
  
  <!-- Message -->
  <text x="400" y="440" font-family="Arial, sans-serif" font-size="24" fill="#666" text-anchor="middle">
    Imagen disponible próximamente
  </text>
</svg>
